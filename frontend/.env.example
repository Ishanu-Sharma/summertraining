# Base URL of the deployed backend API (no trailing slash)
VITE_API_URL=http://localhost:4000

# Google Analytics measurement ID (G-XXXXXXXXXX). Optional.
# Leave this unset and the build ships no analytics script, sets no analytics
# cookie, and shows no cookie banner. Set it and analytics still only loads
# after the visitor accepts the banner. See src/utils/analytics.js.
VITE_GA_ID=
