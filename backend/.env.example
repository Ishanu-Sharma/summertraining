# Server
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=http://localhost:5173

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Database (MariaDB/MySQL) — on Render use the connection details from your MySQL add-on
DB_HOST=localhost
DB_PORT=3306
DB_USER=quad_user
DB_PASSWORD=quad_password
DB_NAME=quad_db
# Optional: some managed MySQL providers require SSL
DB_SSL=false

# Avatar storage (optional). Without these set, avatars are written to local
# disk, which is fine for local dev but is WIPED on every deploy/restart on
# Render's free plan (no persistent disk on that tier). For production, point
# these at an S3-compatible bucket — Cloudflare R2 and Backblaze B2 both have
# free tiers and work with this unmodified.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=the-quad-avatars
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_URL=https://avatars.yourdomain.com

# Outgoing email (optional). Without these set, password-reset emails are
# logged to the console instead of sent — fine for local dev, not for
# production. Works with any standard SMTP provider (Resend, Postmark,
# SendGrid's SMTP relay, etc).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM="The Quad <no-reply@yourdomain.com>"

